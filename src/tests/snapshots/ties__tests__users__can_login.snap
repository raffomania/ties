---
source: src/tests/users.rs
expression: "login_page.dom.find(\"form\").outer_htmls()"
---
<form action="/login" method="post" hx-boost="true" hx-disabled-elt="button" class="flex flex-col w-full"><img src="/assets/logo_icon_only.svg" class="w-24 max-w-full self-center mb-4" /><h1 class="text-2xl font-bold tracking-tight text-center">Sign in to your account</h1><label class="mt-10" for="credentials[username]">Username</label><input type="text" name="credentials[username]" class="rounded py-1.5 px-3 mt-2 bg-white border border-neutral-300 dark:bg-neutral-900 dark:border-neutral-700" value="" required="true" /><label class="mt-4" for="credentials[password]">Password</label><input type="password" name="credentials[password]" class="rounded py-1.5 px-3 mt-2 dark:bg-neutral-900 dark:border-neutral-700 bg-white border border-neutral-300" required="true" /><button type="submit" class="leading-6 bg-neutral-800 dark:bg-neutral-300 mt-5 font-semibold rounded py-1.5 flex items-center justify-center disabled:bg-neutral-500 dark:text-neutral-900 text-neutral-200"><span class="inline-block w-0 h-4"><span class="block w-4 h-4 -ml-6 border-2 rounded-full dark:border-neutral-900 border-neutral-200 animate-spin border-t-transparent htmx-indicator"></span></span>Sign in</button></form>
