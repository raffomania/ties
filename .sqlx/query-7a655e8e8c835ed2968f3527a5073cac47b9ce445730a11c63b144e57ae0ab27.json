  "db_name": "PostgreSQL",
  "query": "\n        insert into bookmarks\n        (ap_id, id, ap_user_id, url, title)\n        values ($1, $2, $3, $4, $5)\n        on conflict(ap_id) do update set\n            -- Never change who owns an existing bookmark: only its owner may\n            -- change it.\n            url = $4,\n            title = $5\n        returning id, created_at, ap_user_id, url, title, ap_id\n        ",
