{
  "db_name": "PostgreSQL",
  "query": "\n        select id, created_at, ap_user_id, url, title, ap_id\n        from bookmarks\n        where ap_user_id = $1\n        and exists(\n            select 1\n            from links\n            inner join lists on links.src_list_id = lists.id\n            where not lists.private\n                and links.dest_bookmark_id = bookmarks.id\n        );\n        ",
